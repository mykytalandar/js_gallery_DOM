"use strict";
var gallery = document.querySelector("#thumbs");
var mainImage = document.querySelector("#largeImg");
gallery.addEventListener("click", function(e) {
    e.preventDefault();
    var link = e.target.closest(".list-item__link");
    if (link) mainImage.src = link.href;
});

